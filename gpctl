#!/bin/zsh
# gpctl: インストール済みの GlobalProtect アプリを Accessibility API 経由で操作する CLI

set -u

readonly VERSION="0.2.0"
readonly APP_PATH="${GPCTL_APP_PATH:-/Applications/GlobalProtect.app}"
readonly PROCESS_NAME="GlobalProtect"
readonly AUTH_MESSAGE="Authentication is required. Complete sign-in in GlobalProtect or your browser."

readonly EXIT_FAILURE=1
readonly EXIT_USAGE=2
readonly EXIT_APP_NOT_AVAILABLE=3
readonly EXIT_PERMISSION=4
readonly EXIT_UNKNOWN_STATE=6

verbose=false

usage() {
  cat <<'USAGE'
Usage: gpctl <command> [options]

Commands:
  connect      Connect to GlobalProtect
  disconnect   Disconnect from GlobalProtect
  refresh      Refresh the GlobalProtect connection
  status       Show the current connection state
  toggle       Connect if not connected, disconnect if connected
  help         Show this help
  version      Show the version

Options:
  --verbose            Show UI detection and state details
USAGE
}

die() {
  local exit_code=$1
  shift
  print -ru2 -- "gpctl: $*"
  exit $exit_code
}

info() {
  print -ru2 -- "$*"
}

log_verbose() {
  [[ $verbose == true ]] || return 0
  print -ru2 -- "[verbose] $*"
}

# GlobalProtect のメニューバーのポップオーバーを開き、UI 要素を操作する。
# mode:
#   dump          静的テキストとボタンを "text:<値>" / "button:<ラベル>" の行で出力する
#   click <label> ラベルが一致するボタンを押す
#   refresh-menu  オプションメニューの Refresh Connection を押す
#   refresh-confirm 確認画面の Refresh Connection ボタンを押す
run_ui_script() {
  local output exit_status
  output=$(osascript - "$@" 2>&1 <<'APPLESCRIPT'
on run argv
	with timeout of 10 seconds
	set mode to item 1 of argv
	if mode is "refresh-confirm" then return my clickRefreshConfirmation()
	tell application "System Events"
		tell process "GlobalProtect"
			set uiElements to my findPopoverElements()
			if uiElements is missing value then
				if mode is "click" then error "UI element not found: GlobalProtect popover closed" number 1001
				click menu bar item 1 of menu bar 2
				repeat 10 times
					delay 0.2
					set uiElements to my findPopoverElements()
					if uiElements is not missing value then exit repeat
				end repeat
			end if
			if uiElements is missing value then error "UI element not found: GlobalProtect popover" number 1001
		end tell
	end tell
	if mode is "dump" then return my dumpElements(uiElements)
	if mode is "click" then return my clickButton(uiElements, item 2 of argv)
	if mode is "refresh-menu" then return my clickRefreshMenuItem(uiElements)
	error "Unknown mode: " & mode
	end timeout
end run

on findPopoverElements()
	tell application "System Events"
		tell process "GlobalProtect"
			repeat with candidateWindow in windows
				try
					set candidateElements to entire contents of candidateWindow
					repeat with e in candidateElements
						try
							if role of e is "AXPopUpButton" and value of attribute "AXIdentifier" of e is "gp.menu.options" then return candidateElements
						end try
					end repeat
				end try
			end repeat
		end tell
	end tell
	return missing value
end findPopoverElements

on dumpElements(uiElements)
	set output to {}
	tell application "System Events"
		repeat with e in uiElements
			try
				set elementRole to role of e
				if elementRole is "AXStaticText" then
					set end of output to "text:" & my textOf(value of e)
				else if elementRole is "AXButton" then
					set end of output to "button:" & my buttonText(e)
				end if
			end try
		end repeat
	end tell
	set AppleScript's text item delimiters to linefeed
	return output as text
end dumpElements

on clickButton(uiElements, targetText)
	tell application "System Events"
		repeat with e in uiElements
			try
				set isTarget to (role of e is "AXButton" and my buttonText(e) is targetText)
			on error
				set isTarget to false
			end try
			if isTarget then
				click e
				return ""
			end if
		end repeat
	end tell
	error "UI element not found: button " & targetText number 1001
end clickButton

on clickRefreshMenuItem(uiElements)
	set optionsButton to missing value
	tell application "System Events"
		repeat with e in uiElements
			try
				if role of e is "AXPopUpButton" and value of attribute "AXIdentifier" of e is "gp.menu.options" then
					set optionsButton to e
					exit repeat
				end if
			end try
		end repeat
		if optionsButton is missing value then error "UI element not found: GlobalProtect options menu" number 1001
		set refreshMenuItem to my findRefreshMenuItem(optionsButton)
		if refreshMenuItem is missing value then
			click optionsButton
			repeat 6 times
				delay 0.25
				set refreshMenuItem to my findRefreshMenuItem(optionsButton)
				if refreshMenuItem is not missing value then exit repeat
			end repeat
		end if
		if refreshMenuItem is missing value then error "UI element not found: Refresh Connection menu item" number 1001
		click refreshMenuItem
		return ""
	end tell
end clickRefreshMenuItem

on findRefreshMenuItem(optionsButton)
	tell application "System Events"
		try
			set menuElements to entire contents of optionsButton
		on error
			return missing value
		end try
		repeat with menuItem in menuElements
			try
				if role of menuItem is "AXMenuItem" then
					set label_ to my textOf(name of menuItem)
					set identifier_ to ""
					try
						set identifier_ to my textOf(value of attribute "AXIdentifier" of menuItem)
					end try
					if identifier_ is "gp.menu.refresh" or label_ is "Refresh Connection" or label_ is "接続を更新" then return menuItem
				end if
			end try
		end repeat
	end tell
	return missing value
end findRefreshMenuItem

on clickRefreshConfirmation()
	tell application "System Events"
		repeat 6 times
			delay 0.5
			set confirmationShown to false
			set refreshButton to missing value
			set refreshElements to entire contents of process "GlobalProtect"
			repeat with e in refreshElements
				try
					set elementRole to role of e
					if elementRole is "AXStaticText" then
						set message_ to my textOf(value of e)
						if message_ contains "Refresh?" or message_ contains "更新?" then set confirmationShown to true
					else if elementRole is "AXButton" then
						set label_ to my buttonText(e)
						if label_ is "Refresh Connection" or label_ is "接続を更新" then set refreshButton to e
					end if
				end try
			end repeat
			if confirmationShown and refreshButton is not missing value then
				click refreshButton
				return ""
			end if
		end repeat
	end tell
	error "UI element not found: Refresh Connection confirmation" number 1001
end clickRefreshConfirmation

on buttonText(e)
	tell application "System Events"
		set result_ to my textOf(name of e)
		if result_ is "" then set result_ to my textOf(description of e)
	end tell
	return result_
end buttonText

on textOf(v)
	if v is missing value then return ""
	return v as text
end textOf
APPLESCRIPT
)
  exit_status=$?
  if (( exit_status == 0 )); then
    print -r -- "$output"
    return 0
  fi

  log_verbose "osascript failed: $output"
  # -1719 はウィンドウ消失でも返るため、番号だけで権限エラーと判断しない。
  if [[ $output == *"-1743"* || $output == *"assistive access"* || $output == *"Not authorized"* ]]; then
    die $EXIT_PERMISSION "Accessibility / Automation permission is missing. See 'macOS Permissions' in README.
$output"
  fi
  die $EXIT_UNKNOWN_STATE "Failed to operate GlobalProtect UI.
$output"
}

# 説明文の「切断」「認証」などを状態と誤認しないよう、UI の行単位でラベルを照合する。
classify_state() {
  local dump=${(L)1} line
  local authentication=false disconnecting=false connecting=false connected=false disconnected=false
  local connect_button=false disconnect_button=false
  for line in ${(f)dump}; do
    case $line in
      (button:sign\ in|button:サインイン|text:authentication|text:authentication\ failed|text:認証が必要|text:認証失敗) authentication=true ;;
      (text:disconnecting|text:disconnecting...|text:切断中|text:切断中...|text:切断中…) disconnecting=true ;;
      (text:connecting|text:connecting...|text:接続中|text:接続中...|text:接続中…) connecting=true ;;
      (text:connected|text:接続済み|text:connected\ -\ internal|text:内部接続) connected=true ;;
      (text:not\ connected|text:disconnected|text:未接続|text:切断) disconnected=true ;;
      (button:disconnect|button:切断) disconnect_button=true ;;
      (button:connect|button:接続) connect_button=true ;;
    esac
  done
  if [[ $connected == true && ( $disconnected == true || $authentication == true ) ]]; then
    print unknown
  elif [[ $authentication == true ]]; then
    print authentication-required
  elif [[ $disconnecting == true ]]; then
    print disconnecting
  elif [[ $connecting == true ]]; then
    print connecting
  elif [[ $connected == true ]]; then
    print connected
  elif [[ $disconnected == true ]]; then
    print disconnected
  elif [[ $disconnect_button == true ]]; then
    print connected
  elif [[ $connect_button == true ]]; then
    print disconnected
  else
    print unknown
  fi
}

button_label_from_dump() {
  local dump=$1 action=$2 localized_action line
  case $action in
    Connect) localized_action=接続 ;;
    Disconnect) localized_action=切断 ;;
  esac
  for line in ${(f)dump}; do
    if [[ $line == "button:$action" || $line == "button:$localized_action" ]]; then
      print -r -- "${line#button:}"
      return 0
    fi
  done
  print -r -- "$action"
}

read_state() {
  local dump state
  dump=$(run_ui_script dump) || exit $?
  log_verbose "UI elements:"$'\n'"$dump"
  state=$(classify_state "$dump")
  log_verbose "state: $state"
  if [[ -n ${1:-} ]]; then
    local action=$1
    if [[ $action == Toggle ]]; then
      if [[ $state == connected ]]; then
        action=Disconnect
      else
        action=Connect
      fi
    fi
    print -r -- "$state|$(button_label_from_dump "$dump" "$action")"
  else
    print -r -- "$state"
  fi
}

ensure_app_running() {
  [[ -d $APP_PATH ]] || die $EXIT_APP_NOT_AVAILABLE "GlobalProtect not found: $APP_PATH"
  pgrep -xq "$PROCESS_NAME" && return 0

  info "Opening GlobalProtect..."
  open -g "$APP_PATH" || die $EXIT_APP_NOT_AVAILABLE "Failed to launch GlobalProtect."
  repeat 10; do
    pgrep -xq "$PROCESS_NAME" && return 0
    sleep 1
  done
  die $EXIT_APP_NOT_AVAILABLE "GlobalProtect did not start."
}

cmd_connect() {
  local state_and_button state button_label
  if (( $# > 0 )); then
    state_and_button=$1
  else
    ensure_app_running
    state_and_button=$(read_state Connect) || exit $?
  fi
  state=${state_and_button%%|*}
  button_label=${state_and_button#*|}

  case $state in
    connected)
      print "Already connected."
      return 0
      ;;
    disconnected)
      run_ui_script click "$button_label" >/dev/null
      print "Connection started. Check 'gpctl status' to confirm it."
      return 0
      ;;
    connecting)
      die $EXIT_FAILURE "GlobalProtect reports Connecting; no action taken. Check 'gpctl status' later."
      ;;
    authentication-required)
      die $EXIT_FAILURE "$AUTH_MESSAGE"
      ;;
    disconnecting)
      die $EXIT_FAILURE "GlobalProtect is disconnecting. Try again later."
      ;;
    *)
      die $EXIT_UNKNOWN_STATE "Could not determine GlobalProtect state. Run with --verbose for details."
      ;;
  esac
}

cmd_disconnect() {
  local state_and_button state button_label
  if (( $# > 0 )); then
    state_and_button=$1
  else
    ensure_app_running
    state_and_button=$(read_state Disconnect) || exit $?
  fi
  state=${state_and_button%%|*}
  button_label=${state_and_button#*|}

  case $state in
    disconnected)
      print "Already disconnected."
      return 0
      ;;
    connected)
      run_ui_script click "$button_label" >/dev/null
      print "Disconnection started. Check 'gpctl status' to confirm it."
      return 0
      ;;
    disconnecting)
      die $EXIT_FAILURE "GlobalProtect reports Disconnecting; no action taken. Check 'gpctl status' later."
      ;;
    connecting | authentication-required)
      die $EXIT_FAILURE "GlobalProtect is connecting. Try again later."
      ;;
    *)
      die $EXIT_UNKNOWN_STATE "Could not determine GlobalProtect state. Run with --verbose for details."
      ;;
  esac
}

cmd_refresh() {
  ensure_app_running
  run_ui_script refresh-menu >/dev/null
  run_ui_script refresh-confirm >/dev/null
  print "Connection refresh started."
}

cmd_status() {
  ensure_app_running
  local state
  state=$(read_state) || exit $?
  print -r -- "$state"

  case $state in
    connected) return 0 ;;
    unknown) return $EXIT_UNKNOWN_STATE ;;
    *) return $EXIT_FAILURE ;;
  esac
}

cmd_toggle() {
  ensure_app_running
  local state_and_button state
  state_and_button=$(read_state Toggle) || exit $?
  state=${state_and_button%%|*}
  if [[ $state == connected ]]; then
    cmd_disconnect "$state_and_button"
  else
    cmd_connect "$state_and_button"
  fi
}

main() {
  if (( $# == 0 )); then
    usage >&2
    exit $EXIT_USAGE
  fi

  local command=$1
  shift
  while (( $# > 0 )); do
    case $1 in
      --verbose)
        verbose=true
        shift
        ;;
      *)
        die $EXIT_USAGE "Unknown option: $1"
        ;;
    esac
  done

  case $command in
    connect) cmd_connect ;;
    disconnect) cmd_disconnect ;;
    refresh) cmd_refresh ;;
    status) cmd_status ;;
    toggle) cmd_toggle ;;
    help | --help | -h) usage ;;
    version | --version) print "gpctl $VERSION" ;;
    *) die $EXIT_USAGE "Unknown command: $command. Run 'gpctl help'." ;;
  esac
}

main "$@"
